# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma separated hostnames. Required in production, e.g. ordinis.example.com
DJANGO_ALLOWED_HOSTS=

# Extra frontend addresses allowed to call the API (comma separated), e.g. https://ordinis.example.com
CORS_EXTRA_ORIGINS=

# Production only: run with  DJANGO_SETTINGS_MODULE=config.settings.production
